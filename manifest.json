{
  "manifest_version": 3,
  "name": "Atalho Pronto",
  "version": "1.3.3",
  "description": "Expanda textos automaticamente ao digitar /atalho.",
  "permissions": [
    "storage"
  ],
  "action": {
    "default_title": "Abrir Atalho Pronto",
    "default_icon": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "model.js",
        "expand.js",
        "ckeditor.js"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "match_origin_as_fallback": true
    }
  ],
  "background": {
    "service_worker": "background.js"
  },

  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
